project_id                     = "example-project"
location                       = "us-central1"
service_name                   = "vertexai-proxy"
image                          = "us-central1-docker.pkg.dev/example-project/proxy/vertexai-proxy:latest"
deployer_service_account_email = "deployer@example-project.iam.gserviceaccount.com"
runtime_service_account_email  = "runtime@example-project.iam.gserviceaccount.com"
vertex_service_account_email   = "vertex@example-project.iam.gserviceaccount.com"
proxy_api_key_secret           = "projects/example-project/secrets/vertexai-proxy-api-key"
proxy_api_key_secret_version   = "latest"
